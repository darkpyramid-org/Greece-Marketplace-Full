# Backend Environment Variables for Greece-Hieroglyphs-Full
#
# Copy this to `.env` and fill in real values. NEVER commit real .env files —
# the repository's root .gitignore blocks them, but please also sanity-check
# with `git status` before pushing.

# Server
PORT=3001
NODE_ENV=development

# Database (Drizzle / node-postgres)
# Example: postgresql://postgres:password@localhost:5432/greece_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/greece_db

# Stripe (optional in development — when unset, mock checkout is used).
# In production NODE_ENV=production, STRIPE_SECRET_KEY and DATABASE_URL are required.
# STRIPE_WEBHOOK_SECRET is required in production when Stripe is configured.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# CORS / Frontend origin(s)
# The first entry's origin is used for checkout-redirect allow-listing.
# For local development, CORS is open (all origins allowed).
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Custom URL scheme(s) allowed for Stripe checkout redirects (mobile app deep links).
# Defaults to "greece:,greece-mobile:" — only change if the mobile app uses a different scheme.
APP_URL_SCHEMES=greece:,greece-mobile:

# Logging
LOG_LEVEL=info

# Demo mode only: trust client-supplied prices when the catalog DB is absent.
# This is force-disabled in production. You almost certainly do NOT want this on.
ALLOW_UNVERIFIED_PRICES=false
